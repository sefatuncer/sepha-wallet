{
  "expo": {
    "name": "Sepha Wallet",
    "slug": "sepha-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "entryPoint": "index.js",
    "scheme": "com.sepha.wallet",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sepha.wallet",
      "useFrameworks": "static",
      "associatedDomains": ["applinks:sefa.io"],
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR codes for receiving and presenting credentials"
      }
    },
    "android": {
      "package": "com.sepha.wallet",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sefa.io",
              "pathPrefix": "/wallet"
            },
            {
              "scheme": "openid-credential-offer"
            },
            {
              "scheme": "openid-vc"
            },
            {
              "scheme": "openid"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#1a1a2e"
    },
    "extra": {
      "eas": {
        "projectId": "sepha-wallet-project"
      },
      "apiBaseUrl": "http://localhost:3000"
    },
    "plugins": [
      "@animo-id/expo-ausweis-sdk",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "useLegacyPackaging": true,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-asset",
      "expo-localization",
      "./withSphereonWalletPods"
    ]
  }
}
